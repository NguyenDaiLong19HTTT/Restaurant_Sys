{
  "openapi": "3.0.3",
  "info": {
    "title": "Restaurant Menu API",
    "version": "1.0.0",
    "description": "Public API qua Gateway; internal API chỉ truy cập Docker backend bằng token riêng cho order-service. Các lệnh quản lý và name-availability chỉ dành CHU_CHUOI. Nhân viên chỉ đọc ACTIVE. Tất cả request hỗ trợ X-Request-Id. UTC ISO 8601."
  },
  "servers": [
    {
      "url": "http://localhost:19081",
      "description": "Gateway development; xem docs/local-stack.json nếu đổi cổng"
    }
  ],
  "paths": {
    "/api/v1/dishes": {
      "get": {
        "summary": "Danh sách món",
        "tags": [
          "Menu"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách phân trang",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Dish"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Sai định dạng hoặc thiếu header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Chưa xác thực",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sai vai trò",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "DISH_NAME_EXISTS / VERSION_CONFLICT / DISH_DELETED / IDEMPOTENCY_CONFLICT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Sai nghiệp vụ hoặc dữ liệu",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
