    "/internal/v1/dishes/resolve": {
      "post": {
        "tags": [
          "Internal"
        ],
        "summary": "Lấy thông tin ACTIVE cho order-service; KHÔNG qua Gateway",
        "servers": [
          {
            "url": "http://menu-service:3000"
          }
        ],
        "security": [
          {
            "serviceToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "dishIds"
                ],
                "properties": {
                  "dishIds": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "dishes"
                      ],
                      "properties": {
                        "dishes": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "id",
                              "code",
                              "name",
                              "priceVnd",
                              "status"
                            ],
                            "properties": {
                              "id": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "code": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 200,
                                "example": "Phở bò đặc biệt",
                                "description": "Trim + Unicode NFC + lowercase cho UNIQUE. Món đã xóa vẫn giữ tên."
                              },
                              "priceVnd": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 999999999999,
                                "example": 85000,
                                "description": "Số nguyên VND, không dùng float."
                              },
                              "status": {
                                "type": "string",
                                "enum": [
                                  "ACTIVE"
                                ]
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Chưa xác thực",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "DISH_UNAVAILABLE nếu bất kỳ ID không tồn tại/DELETED; INVALID_DISH_IDS nếu đầu vào sai",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
